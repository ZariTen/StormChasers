        var shard = MakeStrip( backing, new Vector3( -25,-8,1 ), new Vector3( -9,-4,0 ), new Vector3( 8,-3,-2 ), new Vector3( 24,10,3 ), new Vector4( 2,4,6,1.2f ) );
