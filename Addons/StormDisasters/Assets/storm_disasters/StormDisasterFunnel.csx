    void UpdateDust( float t, float baseRadius )
    {
        float scale = Strength >= 5 ? 0.29f : (Strength == 1 ? 0.19f : 0.24f);
        for ( int i = 0; i < DustCount; i++ )
        {
            var puff = puffs[FallbackCount + i];
            float v = Seed( i + 202 );
            float cycle = Wrap( i / (float)DustCount + t * (0.14f + 0.09f * v) );
            float angle = i * 2.399963f + t * (1.53f + 0.41f * v) + cycle * 1.45f;
            bool skirt = i % 3 != 0;
            float radius = (skirt ? 140f + 675f * cycle * (0.75f + 0.48f * v) : 52f + 195f * cycle) * scale;
            radius += Strength >= 5 ? baseRadius * 0.63f : 0f;
            float size = (skirt ? 290f + 485f * cycle + 95f * v : 260f + 220f * cycle + 90f * v) * scale;
            float z = (skirt ? 13f + 85f * v * (1f - cycle) : 55f + 106f * v * (1f - cycle)) * scale * 1.25f;
            puff.GameObject.WorldPosition = WorldPosition + new Vector3( MathF.Cos( angle ) * radius, MathF.Sin( angle ) * radius * 0.77f, z );
            puff.Size = new Vector2( size, size * (skirt ? 0.38f + 0.16f * v : 0.68f + 0.16f * v) );
            float opacity = Fade( cycle / 0.10f ) * Fade( (1f - cycle) / 0.39f );
            float shade = (skirt ? 0.27f : 0.16f) + 0.13f * v;
            puff.Color = new Color( shade * 1.08f, shade, shade * 0.88f, opacity * (skirt ? 0.84f : 0.94f) );
        }
