        return Mix( Mix( Seed( ix * 127 + iy * 311 + seed * 73 ), Seed( (ix + 1) * 127 + iy * 311 + seed * 73 ), a ),
            Mix( Seed( ix * 127 + (iy + 1) * 311 + seed * 73 ), Seed( (ix + 1) * 127 + (iy + 1) * 311 + seed * 73 ), a ), b );
    }

