    void AddSegment( System.Collections.Generic.List<Vertex> vertices, Vector3 a, Vector3 b, float wa, float wb )
    {
        var l0 = a - Vector3.Left * wa;
        var r0 = a + Vector3.Left * wa * 0.8f;
        var l1 = b - Vector3.Left * wb;
        var r1 = b + Vector3.Left * wb * 0.8f;
        AddFace( vertices, l0, r0, l1 );
        AddFace( vertices, r0, r1, l1 );
    }

    void AddFace( System.Collections.Generic.List<Vertex> vertices, Vector3 a, Vector3 b, Vector3 c )
