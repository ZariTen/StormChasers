// Generated by tools/sync-storm-disasters.cjs; edit the templates or game sources instead.
// Sandbox owns the tornado root and undo; rendering objects stay local.
public sealed class StormDisasterFunnel : Component
{
    [Property] public int Strength { get; set; } = 2;
    [Property] public int Shape { get; set; } = 1; // Rope, Cone, Wedge, V-shaped, Cylinder, Hourglass
    [Property] public float Lifetime { get; set; } = 150f;
    const int FallbackCount = 48;
    // The shared shader fades its lower edge up to floor + .115. Keep that fade below grade.
    const float GroundContactFloor = -0.115f;
    SpriteRenderer[] puffs = new SpriteRenderer[FallbackCount + DustCount];
    ModelRenderer[] fragments = new ModelRenderer[FragmentCount];
    GameObject visuals;
    GameObject debris;
    ModelRenderer volume;
    Texture noise;
    int start;
    float travelAge;
    float heading;
    float routePhase;
    float formedAt;

    // Shared profile values generated from the Storm Chasers game sources.
    const int FunnelNoiseSize = 32;
    const int DustMaskSize = 128;
    const int DustMaskCount = 4;
    float GameHeight()
    {
        if ( Strength <= 0 ) return 3200f;
        if ( Strength == 1 ) return 3480f;
        if ( Strength == 2 ) return 3820f;
        if ( Strength == 3 ) return 4150f;
        if ( Strength == 4 ) return 4490f;
        return 5280f;
    }
    float GameWidthScale() => GameWidthForRating( Strength );
    float GameWidthForRating( int rating )
    {
        if ( rating <= 0 ) return 1f;
        if ( rating == 1 ) return 1.70f;
        if ( rating == 2 ) return 2.25f;
        if ( rating == 3 ) return 3.00f;
        if ( rating == 4 ) return 3.85f;
        return 5.25f;
    }
    const float GameF5WidthScale = 5.25f;
    Vector4 GameRadii()
    {
        if ( Shape == 0 ) return new Vector4( 56f, 61f, 66f, 82f );
        if ( Shape == 2 ) return new Vector4( 1550f, 1700f, 1880f, 2100f );
        if ( Shape == 3 ) return new Vector4( 58f, 129f, 213f, 306f );
        if ( Shape == 4 ) return new Vector4( 108f, 117f, 137f, 201f );
        if ( Shape == 5 ) return new Vector4( 173f, 113f, 91f, 145f );
        return new Vector4( 67f, 97f, 149f, 227f );
    }
    float GameTopRadius()
    {
        if ( Shape == 0 ) return 155f;
        if ( Shape == 2 ) return 2470f;
        if ( Shape == 3 ) return 403f;
        if ( Shape == 4 ) return 312f;
        if ( Shape == 5 ) return 298f;
        return 372f;
    }
    float GameOpenCore() => 480f;

    protected override void OnStart()
    {
        if ( !IsProxy )
        {
            // Sandbox can spawn the prefab well above the surface. Acquire ground before rendering.
            var ground = TraceGround( WorldPosition, 16384f );
            if ( !ground.Hit || ground.Normal.z < 0.65f )
            {
                GameObject.Destroy();
                return;
            }
            WorldPosition = ground.HitPosition;
        }
        weatherEligible = true;
        formedAt = Time.Now;
        var spawn = WorldPosition;
        routePhase = Wrap( MathF.Sin( spawn.x * 0.014f + spawn.y * 0.021f ) * 47.31f ) * MathF.Tau;
        heading = routePhase;
        // A material asset gives s&box a shader compile dependency. Do not cache
        // an anonymous material while the shader is still compiling on first boot.
        var material = Material.Load( "storm_disasters/funnel_volume.vmat" );
        if ( material != null && material.IsValid && !material.IsError && material.Shader.IsValid && !material.Shader.IsError ) noise = CreateNoise();
        if ( noise != null && noise.IsValid && !noise.IsError )
        {
            var proxy = MakeVisual( GameObject, "Condensation Volume" );
            volume = proxy.Components.Create<ModelRenderer>();
            volume.Model = Model.Load( "models/dev/box.vmdl" );
            volume.MaterialOverride = material;
            volume.RenderType = ModelRenderer.ShadowRenderType.Off;
            volume.Attributes.Set( "VortexNoise", noise );
            start = FallbackCount;
        }
        var smoke = Sprite.FromTexture( Texture.Load( "textures/particles/smoke/smoke_static_a.vtex" ) );
        var masks = new Sprite[DustMaskCount];
        for ( int i = 0; i < masks.Length; i++ ) masks[i] = LoadDustMask( i, smoke );
        visuals = MakeVisual( GameObject, "Tornado smoke" );
        for ( int i = start; i < puffs.Length; i++ )
        {
            var sprite = MakeVisual( visuals, "Smoke puff" ).Components.Create<SpriteRenderer>();
            sprite.Sprite = i < FallbackCount ? smoke : masks[(i - FallbackCount) % masks.Length];
            sprite.Billboard = SpriteRenderer.BillboardMode.Always;
            sprite.Opaque = false;
            sprite.Lighting = false;
            sprite.IsSorted = true;
            sprite.AlphaCutoff = 0.008f;
            sprite.DepthFeather = i >= FallbackCount ? 48f : 18f;
            if ( i >= FallbackCount )
            {
                sprite.CameraFadeNear = 4f;
                sprite.CameraFadeFar = 20f;
            }
            sprite.FogStrength = 0.48f;
            puffs[i] = sprite;
        }
        CreateDebris();
        UpdateFunnel();
    }

    GameObject MakeVisual( GameObject parent, string name )
    {
        var obj = Scene.CreateObject();
        obj.Name = name;
        obj.NetworkMode = NetworkMode.Never;
        obj.SetParent( parent, false );
        return obj;
    }

    protected override void OnUpdate()
    {
        // Only the owning peer steers the Sandbox spawn; proxies follow its transform.
        if ( formedAt <= 0f ) formedAt = Time.Now;
        if ( !IsProxy && Time.Now - formedAt >= Duration() )
        {
            GameObject.Destroy();
            return;
        }
        if ( !IsProxy ) UpdateTravel();
        if ( !GameObject.IsValid ) return;
        if ( visuals != null && visuals.IsValid ) UpdateFunnel();
        UpdateWeather();
    }

    void UpdateTravel()
    {
        float dt = MathF.Min( Time.Delta, 0.1f );
        travelAge += dt;
        float speed = 76f + 20f * MathF.Sin( travelAge * 0.23f + routePhase );
        float turn = 0.065f + 0.045f * MathF.Sin( travelAge * 0.16f + routePhase );
        heading += turn * dt;
        var next = WorldPosition + new Vector3( MathF.Cos( heading ), MathF.Sin( heading ), 0f ) * (speed * dt);
        var ground = TraceGround( next, 128f );
        if ( !ground.Hit || ground.Normal.z < 0.65f )
        {
            // Bend back toward solid ground instead of drifting over the edge.
            heading += 1.8f * dt;
            var support = TraceGround( WorldPosition, 128f );
            if ( support.Hit && support.Normal.z >= 0.65f ) WorldPosition = support.HitPosition;
            else GameObject.Destroy();
            return;
        }
        WorldPosition = ground.HitPosition;
    }

    SceneTraceResult TraceGround( Vector3 position, float depth ) =>
        Scene.Trace.Ray( position + Vector3.Up * 64f, position - Vector3.Up * depth )
            .WithoutTags( "player", "trigger" ).IgnoreDynamic().IgnoreKeyframed().Run();

    protected override void OnDisabled()
    {
        StopWeather();
        if ( visuals != null && visuals.IsValid ) visuals.Enabled = false;
        if ( debris != null && debris.IsValid ) debris.Enabled = false;
        if ( volume != null && volume.IsValid ) volume.Enabled = false;
    }

    protected override void OnEnabled()
    {
        if ( visuals != null && visuals.IsValid ) visuals.Enabled = true;
        if ( debris != null && debris.IsValid ) debris.Enabled = true;
        if ( volume != null && volume.IsValid ) volume.Enabled = true;
    }

    protected override void OnDestroy() => StopWeather();

    // One presentation per client/scene, owned by a live tornado. Never network cloud, rain or audio objects.
    const string WeatherTag = "storm_disasters_weather";
    const string WeatherAssets = "storm_disasters/weather_";
    const int RainCount = 480;
    GameObject weather;
    GameObject weatherFocus;
    SpriteRenderer[] cloudDeck = new SpriteRenderer[4];
    SpriteRenderer[] rainDrops = new SpriteRenderer[RainCount];
    SoundFile[] stormTracks = new SoundFile[4];
    SoundHandle[] stormSounds = new SoundHandle[4];
    float[] mixGains = new float[4];
    bool weatherEligible;
    bool underCover;
    float nextWeatherCheck;
    float nextRoofCheck;
    float stormOn;
    float rainTravel;
    float weatherAnchorZ;

    void UpdateWeather()
    {
        if ( !weatherEligible ) return;
        var camera = Scene.Camera;
        if ( camera == null || !camera.IsValid ) return;
        float t = Time.Now;
        if ( t >= nextWeatherCheck )
        {
            nextWeatherCheck = t + 0.35f;
            bool occupied = false;
            float distance = float.MaxValue;
            var eye = camera.WorldPosition;
            weatherFocus = GameObject;
            foreach ( var obj in Scene.GetAllObjects( true ) )
            {
                if ( obj == null || !obj.IsValid || !obj.Enabled ) continue;
                if ( obj.Name == "Storm Disasters Weather" && obj.Tags.Has( WeatherTag ) ) occupied = true;
                if ( obj.Tags.Has( "storm_disaster_tornado" ) && (obj.Parent == null || !obj.Parent.Tags.Has( "storm_disaster_tornado" )) )
                {
                    float candidate = (obj.WorldPosition - eye).WithZ( 0f ).LengthSquared;
                    if ( candidate < distance ) { distance = candidate; weatherFocus = obj; }
                }
            }
            if ( (weather == null || !weather.IsValid) && !occupied ) CreateWeather();
        }
        if ( weather == null || !weather.IsValid ) return;
        var listener = camera.WorldPosition;
        if ( t >= nextRoofCheck )
        {
            nextRoofCheck = t + 0.15f;
            underCover = Scene.Trace.Ray( listener, listener + Vector3.Up * 3500f ).WithoutTags( "player", "trigger" ).Run().Hit;
        }
        float age = t - stormOn;
        float strength = Fade( age / 1.8f );
        var focus = weatherFocus != null && weatherFocus.IsValid ? weatherFocus : GameObject;
        int rating = Strength;
        bool wedge = Shape == 2;
        if ( focus != GameObject )
        {
            wedge = focus.Tags.Has( "storm_disasters_wedge" );
            for ( int i = 0; i <= 5; i++ )
                if ( focus.Tags.Has( "storm_disasters_rating_f" + i ) ) { rating = i; break; }
        }
        float severity = rating / 5f;
        var center = focus.WorldPosition;
        float distanceToStorm = (listener - center).WithZ( 0f ).Length;
        float nearStorm = 1f - Fade( distanceToStorm / 6800f );
        float eyeRadius = GameOpenCore() * GameWidthForRating( rating ) / GameF5WidthScale;
        float eyeReduction = wedge ? 0.87f * (1f - Fade( (distanceToStorm - eyeRadius) / 460f )) : 0f;
        float rain = strength * (0.85f + nearStorm * (0.82f + 0.45f * severity)) * (1f - eyeReduction);
        float gust = strength * (0.38f + 0.62f * severity) * (0.65f + 0.35f * nearStorm);
        UpdateOvercast( age, strength, severity, center );
        UpdateRain( age, listener, underCover ? 0f : rain, gust );
        UpdateStormAudio( age, rain, gust, center, distanceToStorm, severity );
    }

    void CreateWeather()
    {
        stormOn = Time.Now;
        weatherAnchorZ = WorldPosition.z;
        rainTravel = 0f;
        weather = MakeVisual( GameObject, "Storm Disasters Weather" );
        weather.Tags.Add( WeatherTag );
        for ( int i = 0; i < cloudDeck.Length; i++ )
        {
            var cloud = MakeVisual( weather, "Cloud Layer " + i ).Components.Create<SpriteRenderer>();
            cloud.Sprite = Sprite.FromTexture( Texture.Load( WeatherAssets + "cloud_" + i + ".png" ) );
            cloud.Billboard = SpriteRenderer.BillboardMode.None;
            cloud.Opaque = false;
            cloud.IsSorted = true;
            cloud.Lighting = false;
            cloud.FogStrength = 0.04f;
            cloud.AlphaCutoff = 0.006f;
            cloud.DepthFeather = 80f;
            cloudDeck[i] = cloud;
        }
        var rain = MakeVisual( weather, "Nearby Rain" );
        var sprite = Sprite.FromTexture( Texture.Load( WeatherAssets + "drop.png" ) );
        for ( int i = 0; i < rainDrops.Length; i++ )
        {
            var drop = MakeVisual( rain, "Raindrop" ).Components.Create<SpriteRenderer>();
            drop.Enabled = false;
            drop.Sprite = sprite;
            drop.Billboard = SpriteRenderer.BillboardMode.None;
            drop.Opaque = false;
            drop.IsSorted = true;
            drop.Lighting = false;
            drop.AlphaCutoff = 0.001f;
            drop.DepthFeather = 4f;
            rainDrops[i] = drop;
        }
        stormTracks[0] = SoundFile.Load( WeatherAssets + "wind.wav" );
        stormTracks[1] = SoundFile.Load( WeatherAssets + "rain.wav" );
        stormTracks[2] = SoundFile.Load( WeatherAssets + "covered.wav" );
        stormTracks[3] = SoundFile.Load( WeatherAssets + "roar.wav" );
    }

    void UpdateOvercast( float t, float strength, float severity, Vector3 stormCenter )
    {
        for ( int i = 0; i < cloudDeck.Length; i++ )
        {
            var cloud = cloudDeck[i];
            if ( i < 2 )
            {
                cloud.WorldPosition = new Vector3( MathF.Sin( t * 0.013f ) * 520f - i * 1600f, MathF.Sin( t * 0.009f ) * 710f + i * 1100f, weatherAnchorZ + 9200f + i * 1800f );
                cloud.WorldRotation = Rotation.From( new Angles( 90f, -14f + i * 36f, 0f ) );
                cloud.Size = new Vector2( 99000f - i * 4000f, 84000f + i * 7000f );
                float dim = 0.11f + 0.043f * severity;
                cloud.Color = i == 0 ? new Color( 0.30f-dim, 0.33f-dim, 0.38f-dim, 0.78f*strength )
                    : new Color( 0.46f-dim, 0.50f-dim, 0.57f-dim, 0.80f*strength );
            }
            else
            {
                int band = i - 1;
                float drift = MathF.Sin( t * (0.027f + 0.008f * band) + band );
                cloud.WorldPosition = stormCenter.WithZ( 0f ) * 0.21f + new Vector3( -1000f*band + 680f*drift, 1700f-1400f*band+530f*drift, weatherAnchorZ+7200f+760f*band );
                cloud.WorldRotation = Rotation.From( new Angles( 90f, -35f + 29f * band + 4f * drift, 0f ) );
                cloud.Size = new Vector2( 58000f + 4600f*band, 49000f + 3300f*band ) * (1f + 0.16f*severity);
                float tone = 0.14f + 0.067f * band - 0.027f * severity;
                cloud.Color = new Color( tone*0.89f, tone, tone*1.15f, strength*(0.65f - band*0.065f) );
            }
        }
    }

    float WrapNear( float value, float center, float span ) => center + (Wrap( (value-center)/span + 0.5f )-0.5f)*span;

    void UpdateRain( float t, Vector3 eye, float exposure, float gust )
    {
        var wind = new Vector3( 0.42f, 0.91f, 0f );
        float speed = 320f + 465f * gust;
        rainTravel += speed * Time.Delta;
        float travel = rainTravel + 105f * MathF.Sin( t * 0.84f );
        float speedAndGust = speed + 88.2f * MathF.Cos( t * 0.84f );
        float density = MathF.Min( 1f, 0.24f + 0.45f * exposure );
        for ( int i = 0; i < rainDrops.Length; i++ )
        {
            var drop = rainDrops[i];
            float v = Seed( i + 214 );
            if ( exposure <= 0.025f || v > density ) { drop.Enabled = false; continue; }
            bool near = i < 360;
            float span = near ? 660f : 1830f;
            float height = near ? 660f : 1660f;
            float lift = near ? 110f : 350f;
            float fall = 850f + 600f*v;
            float coupling = 1.15f-0.42f*v;
            var air = wind * (coupling * travel);
            var position = new Vector3( WrapNear( Seed( i+702 )*span+air.x, eye.x, span ), WrapNear( Seed( i+1299 )*span+air.y, eye.y, span ), WrapNear( Seed( i+1837 )*height-t*fall, eye.z+lift, height ) );
            var delta = position-eye;
            float distance = delta.Length;
            float fade = near ? Fade( (distance-57f)/108f ) * Fade( (430f-distance)/155f ) : Fade( (distance-270f)/250f ) * Fade( (1060f-distance)/320f );
            float seam = MathF.Max( MathF.Abs( delta.x ), MathF.Abs( delta.y ) );
            fade *= Fade( (span*0.5f-seam)/(span*0.14f) ) * Fade( (height*0.5f-MathF.Abs( delta.z-lift ))/(height*0.12f) );
            float opacity = MathF.Min( near ? 0.39f : 0.25f, exposure*(near ? 0.16f+0.14f*v : 0.08f+0.08f*v) ) * fade;
            if ( opacity <= 0.007f ) { drop.Enabled = false; continue; }
            var up = (Vector3.Up*fall - wind*(coupling*speedAndGust)).Normal;
            var normal = -delta - up * Vector3.Dot( -delta, up );
            drop.WorldPosition = position;
            drop.WorldRotation = Rotation.LookAt( normal.LengthSquared > 0.001f ? normal.Normal : Vector3.Cross( up, Vector3.Forward ).Normal, up );
            float shade = 0.46f + 0.24f*v;
            drop.Size = new Vector2( near ? 1.35f+0.85f*v : 1.8f+1.2f*v, (9f+13f*v+4f*exposure)*(near ? 0.56f+0.44f*Fade( (distance-100f)/175f ) : 1f) );
            drop.Color = new Color( shade*0.80f, shade*0.90f, shade, opacity );
            drop.Enabled = true;
        }
    }

    void UpdateStormAudio( float t, float rain, float gust, Vector3 center, float distance, float severity )
    {
        float intensity = MathF.Min( 1f, rain / 2.6f );
        float pulse = 0.81f + 0.13f*MathF.Sin( t*0.81f ) + 0.06f*MathF.Sin( t*1.83f+0.5f );
        int playing = 0;
        for ( int i = 0; i < stormSounds.Length; i++ )
        {
            float target = i == 0 ? (0.052f + 0.54f*gust)*pulse*(underCover ? 0.30f : 1f) : i == 1 ? MathF.Pow( intensity, 1.28f )*0.65f*(underCover ? 0.06f : 1f)
                : i == 2 ? (underCover ? intensity*0.47f : 0f) : (1f-Fade( (distance-550f)/(4800f+3600f*severity) ))*(0.68f+0.32f*severity)*(underCover ? 0.57f : 1f);
            var handle = stormSounds[i];
            if ( (handle == null || !handle.IsValid || handle.Finished) && stormTracks[i] != null )
            {
                handle = Sound.PlayFile( stormTracks[i], 0.001f, 1f, 0f, 0.22f );
                handle.SpacialBlend = i == 3 ? 0.88f : 0f;
                handle.DistanceAttenuation = false;
                handle.OcclusionEnabled = false;
                handle.ReverbEnabled = false;
                handle.DopplerScale = 0f;
                stormSounds[i] = handle;
            }
            if ( handle == null || !handle.IsValid || handle.Finished ) continue;
            if ( handle.IsPlaying ) playing++;
            mixGains[i] += (target-mixGains[i])*(1f-MathF.Exp( -Time.Delta*4.5f ));
            handle.Volume = mixGains[i];
            if ( i == 0 ) handle.Pitch = 0.93f+0.075f*gust;
            if ( i == 3 ) { handle.Position = center + Vector3.Up*110f; handle.Pitch = 0.98f-0.17f*severity+0.025f*MathF.Sin( t*1.12f ); }
        }
        if ( playing == 4 ) weather.Tags.Add( "storm_disasters_audio_live" );
        else weather.Tags.Remove( "storm_disasters_audio_live" );
    }

    void StopWeather()
    {
        if ( stormSounds != null )
        {
            for ( int i = 0; i < stormSounds.Length; i++ )
            {
                var handle = stormSounds[i];
                if ( handle != null && handle.IsValid ) handle.Stop( 0.13f );
                stormSounds[i] = null;
                mixGains[i] = 0f;
            }
        }
        if ( weather != null && weather.IsValid ) weather.Destroy();
        weather = null;
    }

    Sprite LoadDustMask( int variant, Sprite fallback )
    {
        string name = "storm_disasters/dust_mask_" + variant;
        string path = name + ".txt";
        if ( !FileSystem.Mounted.FileExists( path ) ) return fallback;
        var data = Json.Deserialize<byte[]>( FileSystem.Mounted.ReadAllText( path ) );
        if ( data == null || data.Length != DustMaskSize * DustMaskSize * 4 ) return fallback;
        return Sprite.FromTexture( Texture.Create( DustMaskSize, DustMaskSize, ImageFormat.RGBA8888 ).WithName( name ).WithData( data ).Finish() );
    }

    void CreateDebris()
    {
        debris = MakeVisual( GameObject, "Airborne Debris" );
        var material = Material.Load( "storm_disasters/debris.vmat" );
        var box = Model.Load( "models/dev/box.vmdl" );
        var backing = Material.Load( "materials/dev/primary_white.vmat" );
        var splinter = MakeStrip( backing, new Vector3( -25,-5,0 ), new Vector3( -8,-3,2 ), new Vector3( 8,2,-1 ), new Vector3( 25,8,2 ), new Vector4( 1.2f,3,2,0.35f ) );
        var sheet = MakeStrip( backing, new Vector3( -25,6,0 ), new Vector3( -10,2,2 ), new Vector3( 9,-3,-3 ), new Vector3( 25,2,4 ), new Vector4( 3,9,5,2 ) );
        var shard = MakeStrip( backing, new Vector3( -25,-8,1 ), new Vector3( -9,-4,0 ), new Vector3( 8,-3,-2 ), new Vector3( 24,10,3 ), new Vector4( 2,4,6,1.2f ) );
        for ( int i = 0; i < fragments.Length; i++ )
        {
            var piece = MakeVisual( debris, "Flying fragment" ).Components.Create<ModelRenderer>();
            bool heavy = i % 4 == 0;
            piece.Model = heavy ? (i % 8 == 0 ? box : sheet) : (i % 3 == 0 ? splinter : (i % 3 == 1 ? sheet : shard));
            piece.RenderType = ModelRenderer.ShadowRenderType.Off;
            if ( material != null && material.IsValid && !material.IsError && material.Shader.IsValid && !material.Shader.IsError )
                piece.MaterialOverride = material;
            float shade = 0.038f + (heavy ? 0.105f : 0.068f) * SurfaceSeed( i + 424 );
            piece.Tint = new Color( shade * 1.08f, shade, shade * 0.88f, 1f );
            piece.Attributes.Set( "FragmentColor", new Vector3( shade * 0.30f, shade * 0.25f, shade * 0.19f ) );
            fragments[i] = piece;
        }
    }

    Model MakeStrip( Material backing, Vector3 a, Vector3 b, Vector3 c, Vector3 d, Vector4 widths )
    {
        var vertices = new System.Collections.Generic.List<Vertex>();
        AddSegment( vertices, a, b, widths.x, widths.y );
        AddSegment( vertices, b, c, widths.y, widths.z );
        AddSegment( vertices, c, d, widths.z, widths.w );
        var mesh = new Mesh( backing, MeshPrimitiveType.Triangles );
        mesh.CreateVertexBuffer<Vertex>( vertices.Count, vertices );
        var bounds = new BBox( new Vector3( -26,-22,-8 ), new Vector3( 26,22,8 ) );
        mesh.Bounds = bounds;
        return new ModelBuilder().AddMesh( mesh ).WithViewBounds( bounds ).Create();
    }

    void AddSegment( System.Collections.Generic.List<Vertex> vertices, Vector3 a, Vector3 b, float wa, float wb )
    {
        var l0 = a - Vector3.Left * wa;
        var r0 = a + Vector3.Left * wa * 0.8f;
        var l1 = b - Vector3.Left * wb;
        var r1 = b + Vector3.Left * wb * 0.8f;
        AddFace( vertices, l0, r0, l1 );
        AddFace( vertices, r0, r1, l1 );
    }

    void AddFace( System.Collections.Generic.List<Vertex> vertices, Vector3 a, Vector3 b, Vector3 c )
    {
        var normal = Vector3.Cross( b - a, c - a ).Normal;
        var tangent = (c - a).Normal;
        vertices.Add( new Vertex( a, normal, tangent, new Vector4( 0,0,0,0 ) ) );
        vertices.Add( new Vertex( b, normal, tangent, new Vector4( 0,1,0,0 ) ) );
        vertices.Add( new Vertex( c, normal, tangent, new Vector4( 1,0,0,0 ) ) );
        vertices.Add( new Vertex( a, -normal, tangent, new Vector4( 0,0,0,0 ) ) );
        vertices.Add( new Vertex( c, -normal, tangent, new Vector4( 1,0,0,0 ) ) );
        vertices.Add( new Vertex( b, -normal, tangent, new Vector4( 0,1,0,0 ) ) );
    }

    Texture CreateNoise()
    {
        const string asset = "storm_disasters/funnel_density.txt";
        if ( !FileSystem.Mounted.FileExists( asset ) ) return null;
        // The standalone algorithm is baked before launch; avoid running its voxel loop in Breen.
        var data = Json.Deserialize<byte[]>( FileSystem.Mounted.ReadAllText( asset ) );
        const int n = FunnelNoiseSize;
        if ( data == null || data.Length != n * n * n * 4 ) return null;
        return Texture.CreateVolume( n, n, n, ImageFormat.RGBA8888 ).WithName( "storm_disasters/funnel_density_canonical" ).WithData( data ).Finish();
    }

    float Smooth( float x ) => x * x * (3f - 2f * x);
    float Fade( float x ) => Smooth( MathF.Min( 1f, MathF.Max( 0f, x ) ) );
    float Wrap( float x ) => x - MathF.Floor( x );
    float Seed( int i ) => Wrap( MathF.Sin( i * 115.37f + 5.64f ) * 912.376f );
    float Mix( float a, float b, float t ) => a + (b - a) * t;
    Vector3 FunnelAxis( float t, float h, float groundScale, float rope )
    {
        float bend = MathF.Sin( 4.2f * h - t * 0.65f );
        var axis = new Vector3( h * (bend * 222f - 65f), h * h * 400f + MathF.Sin( 0.42f * t + h * 6.2f ) * 102f * h, 0f );
        if ( Shape == 2 ) return axis * 0.42f;
        float wave = MathF.Sin( h * MathF.Tau ) * MathF.Sin( h * MathF.PI ) * (0.85f + 0.15f * MathF.Sin( t * 0.66f ));
        axis += new Vector3( 180f, -640f, 0f ) * ((rope + (Shape == 0 ? 0.94f : 0f)) * wave);
        if ( Shape == 4 ) axis += new Vector3( 175f, -315f, 0f ) * (MathF.Sin( h * MathF.PI ) * (0.66f + 0.34f * MathF.Cos( t * 0.28f )));
        return axis * groundScale;
    }

    void UpdateFunnel()
    {
        float height = GameHeight();
        float t = MathF.Max( 0f, Time.Now - formedAt );
        float duration = Duration();
        float phaseScale = MathF.Min( 24f, duration );
        float progress = t / phaseScale;
        float remaining = (duration - t) / phaseScale;
        float cloudLife = Fade( progress / 0.10f ) * Fade( remaining / 0.09f );
        float condensation = Fade( progress / 0.095f ) * Fade( remaining / 0.10f );
        float circulation = Fade( progress / 0.055f ) * Fade( remaining / 0.095f );
        float rope = Fade( (0.29f - remaining) / 0.24f );

        float groundScale = MathF.Sqrt( GameWidthScale() );
        // The walk-in wedge radii are already game-sized at F5.
        float wedgeScale = GameWidthScale() / GameF5WidthScale;
        float width = Shape == 2 ? wedgeScale : GameWidthScale() * (1f - 0.29f * rope);
        var radii = GameRadii() * width;
        float top = GameTopRadius() * width;
        float baseRadius = radii.x;
        float flare = top - baseRadius;
        if ( volume != null && volume.IsValid ) UpdateVolume( t, height, radii, top, groundScale, wedgeScale, rope, cloudLife, condensation );
        // Hot reload retains old instance fields; only fresh spawns own the new pools.
        if ( puffs.Length != FallbackCount + DustCount || debris == null || fragments.Length != FragmentCount ) return;
        for ( int i = start; i < FallbackCount; i++ )
        {
            // Keep a ring of fallback puffs at the ground while the others spiral upward.
            float h = i < 8 ? 0f : Wrap( i / (float)FallbackCount + t * 0.12f );
            float a = i * 2.399963f + t * (2.5f - h);
            float radius = SampleRadii( radii, top, h );
            float size = baseRadius * 0.95f + 38f + flare * h * h;
            var puff = puffs[i];
            puff.GameObject.WorldPosition = WorldPosition + FunnelAxis( t, h, groundScale, rope ) + new Vector3( MathF.Cos( a ) * radius, MathF.Sin( a ) * radius, 12f + height * h );
            puff.Size = new Vector2( size, size * 1.28f );
            puff.Color = new Color( 0.24f, 0.25f, 0.27f, 0.69f * condensation );
        }
        UpdateDust( t, height, groundScale, Shape == 2 ? 1f : 0f, wedgeScale, radii, top, rope, circulation );
        UpdateDebris( t, height, radii, top, groundScale, rope, circulation, progress );
    }

    void UpdateDustShroud( SpriteRenderer puff, int i, float seed, float t, float height, float groundScale, Vector4 radii, float top, float rope, float circulation )
    {
        float intensity = DustIntensity();
        // Stagger the rising sheets so some are always crossing in front of the funnel's foot.
        float life = Wrap( i / (float)DustCount + t * (0.30f + 0.07f * seed + 0.18f * intensity) );
        float angle = (i / 3f) * GoldenAngle + t * (1.90f + 0.42f * seed + 0.85f * intensity) + life * 1.5f;
        float liftScale = MathF.Min( 1.40f, groundScale );
        float z = (34f + (325f + 205f * intensity * seed) * life) * liftScale;
        float h = z / height;
        float wall = SampleRadii( radii, top, h );
        bool wedge = Shape == 2;
        float radius = wall * (wedge ? 1.03f : 1.08f) + (46f + 120f * life) * groundScale;
        float breadth = wall * (wedge ? 0.64f : 0.70f) + (280f + 100f * life) * groundScale;
        var center = FunnelAxis( t, h, groundScale, rope );
        puff.WorldPosition = WorldPosition + center + Orbit( angle, radius, 0.94f ) + Vector3.Up * z;
        puff.Size = new Vector2( breadth * (1f + 0.20f * intensity), (145f + 105f * life + 55f * seed) * liftScale * (1f - 0.28f * intensity) );
        puff.FogStrength = .48f;
        float shade = 0.18f + 0.10f * seed + 0.03f * life;
        float opacity = Fade( life / .13f ) * Fade( (1f - life) / .32f );
        puff.Color = new Color( shade * 1.09f, shade, shade * .88f, (.80f - .15f * intensity) * opacity * circulation );
    }

    float DustIntensity() => MathF.Min( 5f, MathF.Max( 0f, Strength ) ) / 5f;

