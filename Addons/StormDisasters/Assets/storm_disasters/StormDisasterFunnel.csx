    float TileNoise( int x, int y, int z, int cells, float seed )
    {
        int step = 16 / cells;
        int a = x / step;
        int b = y / step;
        int c = z / step;
        float u = Smooth( (x % step) / (float)step );
        float v = Smooth( (y % step) / (float)step );
        float w = Smooth( (z % step) / (float)step );
        return Mix( Layer( a, b, c, cells, seed, u, v ), Layer( a, b, c + 1, cells, seed, u, v ), w );
    }

    float Layer( int a, int b, int c, int cells, float seed, float u, float v )
    {
        return Mix( Mix( Node( a, b, c, cells, seed ), Node( a + 1, b, c, cells, seed ), u ),
            Mix( Node( a, b + 1, c, cells, seed ), Node( a + 1, b + 1, c, cells, seed ), u ), v );
    }

    float Node( int a, int b, int c, int cells, float seed )
    {
        float wave = MathF.Sin( (a % cells) * 12.9898f + (b % cells) * 78.233f + (c % cells) * 39.425f + seed ) * 43758.5453f;
        return wave - MathF.Floor( wave );
    }

    float Smooth( float x ) => x * x * (3f - 2f * x);
    float Fade( float x ) => Smooth( MathF.Min( 1f, MathF.Max( 0f, x ) ) );
    float Wrap( float x ) => x - MathF.Floor( x );
    float Seed( int i ) => Wrap( MathF.Sin( i * 115.37f + 5.64f ) * 912.376f );
