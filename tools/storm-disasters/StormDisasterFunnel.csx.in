// Sandbox owns the tornado root and undo; rendering objects stay local.
public sealed class StormDisasterFunnel : Component
{
    [Property] public int Strength { get; set; } = 2;
    [Property] public int Shape { get; set; } = 1; // Rope, Cone, Wedge, V-shaped, Cylinder, Hourglass
    [Property] public float Lifetime { get; set; } = 150f;

    const int FallbackCount = 48;

    // The shared shader fades its lower edge up to floor + .115. Keep that fade below grade.
    const float GroundContactFloor = -0.115f;
    SpriteRenderer[] puffs = new SpriteRenderer[FallbackCount];
    bool removedDustOverlays;
    ModelRenderer[] fragments = new ModelRenderer[FragmentCount];
    GameObject visuals;
    GameObject debris;
    ModelRenderer volume;
    Texture noise;
    int start;
    float travelAge;
    float heading;
    float routePhase;
    float formedAt;
    float nextWindPulse;
    float lastWindPulse;
    System.Collections.Generic.Dictionary<GameObject, float> nextUnfreezeRoll;
    int unfreezeRolls;
    System.Collections.Generic.Dictionary<GameObject, Vector4> propOrbits;
    System.Collections.Generic.List<GameObject> orbitTouched;
    System.Collections.Generic.List<GameObject> orbitClaims;
    System.Collections.Generic.List<GameObject> orbitReap;
    const string OrbitClaimTag = "storm_disasters_orbit_claim";
    const string OrbitReleaseTag = "storm_disasters_orbit_release";
    const string OrbitReleasePrefix = "storm_disasters_orbit_time_";
    string orbitOwnerTag;
    int orbitSerial;

    /* SHARED_GAME_PROFILE */

    protected override void OnStart()
    {
        if ( !IsProxy )
        {
            // Sandbox can spawn the prefab well above the surface. Acquire ground before rendering.
            var ground = TraceGround( WorldPosition, 16384f );
            if ( !ground.Hit || ground.Normal.z < 0.65f )
            {
                GameObject.Destroy();
                return;
            }
            WorldPosition = ground.HitPosition;
        }
        weatherEligible = true;
        formedAt = Time.Now;
        var spawn = WorldPosition;
        routePhase = Wrap( MathF.Sin( spawn.x * 0.014f + spawn.y * 0.021f ) * 47.31f ) * MathF.Tau;
        heading = routePhase;
        // A material asset gives s&box a shader compile dependency. Do not cache
        // an anonymous material while the shader is still compiling on first boot.
        var material = Material.Load( "storm_disasters/funnel_volume.vmat" );
        if ( material != null && material.IsValid && !material.IsError && material.Shader.IsValid && !material.Shader.IsError ) noise = CreateNoise();
        if ( noise != null && noise.IsValid && !noise.IsError )
        {
            var proxy = MakeVisual( GameObject, "Condensation Volume" );
            volume = proxy.Components.Create<ModelRenderer>();
            volume.Model = Model.Load( "models/dev/box.vmdl" );
            volume.MaterialOverride = material;
            volume.RenderType = ModelRenderer.ShadowRenderType.Off;
            volume.Attributes.Set( "VortexNoise", noise );
            start = FallbackCount;
        }
        else
        {
            var smoke = Sprite.FromTexture( Texture.Load( "textures/particles/smoke/smoke_static_a.vtex" ) );
            visuals = MakeVisual( GameObject, "Tornado smoke" );
            for ( int i = 0; i < FallbackCount; i++ )
            {
                var sprite = MakeVisual( visuals, "Smoke puff" ).Components.Create<SpriteRenderer>();
                sprite.Sprite = smoke;
                sprite.Billboard = SpriteRenderer.BillboardMode.Always;
                sprite.Opaque = false;
                sprite.Lighting = false;
                sprite.IsSorted = true;
                sprite.AlphaCutoff = 0.008f;
                sprite.DepthFeather = 18f;
                sprite.FogStrength = 0.48f;
                puffs[i] = sprite;
            }
        }
        CreateDebris();
        UpdateFunnel();
    }

    GameObject MakeVisual( GameObject parent, string name )
    {
        var obj = Scene.CreateObject();
        obj.Name = name;
        obj.NetworkMode = NetworkMode.Never;
        obj.SetParent( parent, false );
        return obj;
    }

    protected override void OnUpdate()
    {
        // Only the owning peer steers the Sandbox spawn; proxies follow its transform.
        if ( formedAt <= 0f ) formedAt = Time.Now;
        if ( !IsProxy && Time.Now - formedAt >= Duration() )
        {
            GameObject.Destroy();
            return;
        }
        if ( !IsProxy ) UpdateTravel();
        if ( !GameObject.IsValid ) return;
        if ( !IsProxy && Networking.IsHost ) UpdatePropWind();
        if ( (volume != null && volume.IsValid) || (visuals != null && visuals.IsValid) ) UpdateFunnel();
        UpdateWeather();
    }

    void UpdatePropWind()
    {
        float now = Time.Now;
        if ( now < nextWindPulse ) return;
        float dt = lastWindPulse > 0f ? Math.Clamp( now - lastWindPulse, 0f, 0.2f ) : 0.08f;
        lastWindPulse = now;
        nextWindPulse = now + 0.08f;
        float age = now - formedAt;
        float remaining = Duration() - age;
        float ramp = Fade( age / 0.9f ) * Fade( remaining / 2.3f );
        if ( ramp <= 0f ) return;

        int rating = Math.Clamp( Strength, 0, 5 );
        // Representative EF-band peak gusts for the air, not prop velocities.
        float peak = (rating == 0 ? 75f : rating == 1 ? 98f : rating == 2 ? 123f : rating == 3 ? 150f : rating == 4 ? 184f : 220f) * 17.6f;
        float loft = rating == 0 ? 0f : rating == 1 ? 0.08f : rating == 2 ? 0.35f : rating == 3 ? 0.85f : rating == 4 ? 1.65f : 2.85f;

        float unfreezeChance = rating == 3 ? 0.20f : rating == 4 ? 0.40f : rating == 5 ? 0.65f : 0f;
        float unfreezeCooldown = rating == 3 ? 20f : rating == 4 ? 15f : 10f;
        float height = GameHeight();
        float widthScale = GameWidthScale();
        float groundScale = MathF.Sqrt( widthScale );
        float rope = Fade( (0.29f - remaining / MathF.Min( 24f, Duration() )) / 0.24f );
        bool wedge = Shape == 2;
        float width = wedge ? widthScale / GameF5WidthScale : widthScale * (1f - 0.29f * rope);
        float eye = wedge ? GameOpenCore() * width : 0f;
        var radii = GameRadii() * width;
        float top = GameTopRadius() * width;
        int pushed = 0;
        if ( orbitOwnerTag == null ) orbitOwnerTag = "sd_orbit_" + GameObject.Id.ToString( "N" ).Substring( 0, 16 );
        if ( orbitTouched == null ) orbitTouched = new System.Collections.Generic.List<GameObject>();
        else orbitTouched.Clear();
        foreach ( var prop in Scene.GetAllComponents<Prop>() )
        {
            if ( prop.IsStatic || prop.GameObject.Tags.Has( "player" ) ) continue;
            var offset = prop.WorldPosition - WorldPosition;
            if ( offset.z < -48f || offset.z >= height * 0.82f || offset.WithZ( 0f ).Length > top * 3f + 512f ) continue;
            var body = prop.GameObject.GetComponent<Rigidbody>();
            if ( body == null || !body.IsValid || body.IsProxy ) continue;
            if ( body.MotionEnabled && (pushed >= 64 || body.Mass <= 0f) ) continue;
            if ( !body.MotionEnabled && (unfreezeChance <= 0f || ramp < 0.35f) ) continue;

            var model = prop.Model;
            if ( model == null || !model.IsValid || model.IsError ) continue;
            var scale = prop.WorldScale;
            var bounds = model.Bounds;
            var localCenter = bounds.Center * scale;
            var point = prop.WorldPosition + prop.WorldRotation * localCenter;
            var sampleOffset = point - WorldPosition;
            if ( sampleOffset.z < -32f ) continue;
            float z = MathF.Max( sampleOffset.z, 0f );
            var obj = prop.GameObject;
            if ( obj.Tags.Has( OrbitClaimTag ) && !obj.Tags.Has( orbitOwnerTag ) ) continue;
            if ( HasReleaseCooldown( obj, now, z ) ) continue;
            float h = Math.Clamp( z / height, 0f, 1f );
            var flat = (sampleOffset - FunnelAxis( age, h, groundScale, rope )).WithZ( 0f );
            float distance = flat.Length;
            float wall = SampleRadii( radii, top, h );
            float rPeak = MathF.Max( 48f, eye > 0f ? MathF.Max( eye * 1.25f, wall * 0.55f ) : wall * 0.92f );
            var wind = VortexWind( flat, distance, z, h, age, ramp, peak, wall, rPeak, eye );
            if ( wind.Length < 10f ) continue;

            // A nearby solid obstruction reduces wind on its lee side. Ignore
            // movable bodies so a stack of wind-driven props cannot shield itself.
            var horizontal = wind.WithZ( 0f );
            bool sheltered = horizontal.Length > 10f && Scene.Trace.Ray( point, point - horizontal.Normal * 240f )
                .WithoutTags( "player", "trigger" ).IgnoreDynamic().IgnoreKeyframed().Run().Hit;
            if ( sheltered ) wind *= 0.35f;
            if ( !body.MotionEnabled )
            {
                // Calm parts of the eye and the weak fringe don't pull props loose.
                if ( wind.Length < peak * 0.18f ) continue;
                if ( nextUnfreezeRoll == null ) nextUnfreezeRoll = new System.Collections.Generic.Dictionary<GameObject, float>();
                if ( nextUnfreezeRoll.ContainsKey( obj ) && now < nextUnfreezeRoll[obj] ) continue;
                nextUnfreezeRoll[obj] = now + unfreezeCooldown;
                unfreezeRolls++;
                int seed = (int)(formedAt * 97f + routePhase * 825f) + unfreezeRolls;
                if ( Seed( seed ) >= unfreezeChance ) continue;
                body.MotionEnabled = true;
            }
            float mass = body.Mass;
            if ( pushed >= 64 || mass <= 0f ) continue;
            var dimensions = bounds.Size * scale;
            if ( rating < 2 || !CarryPropInOrbit( obj, body, flat, distance, z, rPeak, height, peak, wind, sheltered, mass, now, dt, rating, prop.WorldRotation, dimensions ) )
                ApplyAirDrag( body, prop.WorldRotation, dimensions, wind, mass, dt, loft );
            pushed++;
        }
        // Release claims when a prop leaves the field, is frozen, or disappears.
        if ( propOrbits == null ) return;
        if ( orbitReap == null ) orbitReap = new System.Collections.Generic.List<GameObject>();
        else orbitReap.Clear();
        if ( orbitClaims == null ) return;
        foreach ( var obj in orbitClaims )
            if ( !orbitTouched.Contains( obj ) ) orbitReap.Add( obj );
        foreach ( var obj in orbitReap ) DropOrbit( obj );
    }

    bool HasReleaseCooldown( GameObject obj, float now, float z )
    {
        if ( !obj.Tags.Has( OrbitReleaseTag ) ) return false;
        if ( z > 90f ) return true;
        int tick = (int)now;
        for ( int i = 0; i <= 6; i++ )
            if ( obj.Tags.Has( OrbitReleasePrefix + (tick - i) ) ) return true;
        string expired = null;
        foreach ( var tag in obj.Tags )
            if ( tag.StartsWith( OrbitReleasePrefix ) ) { expired = tag; break; }
        if ( expired != null ) obj.Tags.Remove( expired );
        obj.Tags.Remove( OrbitReleaseTag );
        return false;
    }

    void ClearOrbitClaim( GameObject obj )
    {
        if ( obj != null && obj.IsValid && orbitOwnerTag != null && obj.Tags.Has( orbitOwnerTag ) )
        {
            obj.Tags.Remove( orbitOwnerTag );
            obj.Tags.Remove( OrbitClaimTag );
        }
    }

    void DropOrbit( GameObject obj )
    {
        ClearOrbitClaim( obj );
        propOrbits.Remove( obj );
        if ( orbitClaims != null ) orbitClaims.Remove( obj );
    }

    void ClearOrbits()
    {
        if ( orbitClaims == null ) return;
        foreach ( var obj in orbitClaims ) ClearOrbitClaim( obj );
        orbitClaims.Clear();
        if ( propOrbits != null ) propOrbits.Clear();
    }

    Vector3 VortexWind( Vector3 flat, float distance, float z, float h, float age, float ramp, float peak, float wall, float rPeak, float eye )
    {
        float verticalFade = 1f - Fade( (h - 0.32f) / 0.48f );
        if ( verticalFade <= 0f ) return Vector3.Zero;
        if ( distance < 1f ) return Vector3.Zero;
        // Modified Rankine vortex: rotating core with power-law exterior decay.
        float q = distance / rPeak;
        float outer = MathF.Max( rPeak * 2.75f, wall * 1.55f );
        if ( distance >= outer ) return Vector3.Zero;
        float swirl = q < 1f ? q : MathF.Pow( q, -0.75f );
        if ( eye > 0f ) swirl *= 0.13f + 0.87f * Fade( (distance - eye * 0.35f) / (eye * 0.70f) );
        float radialFade = 1f - Fade( (distance / outer - 0.63f) / 0.37f );
        float gust = 0.92f + 0.08f * MathF.Sin( age * 2.1f + flat.x * 0.0031f + flat.y * 0.0023f + routePhase );
        float strength = peak * swirl * radialFade * verticalFade * ramp * gust;
        var radial = flat / distance;
        var tangent = new Vector3( -radial.y, radial.x, 0f );
        float inflow = 0.30f * (1f - Fade( h / 0.40f ));
        float updraft = 0.60f * swirl * z / (z + 34f + rPeak * 0.055f);
        return (tangent - radial * inflow + Vector3.Up * updraft) * strength;
    }

    bool CarryPropInOrbit( GameObject obj, Rigidbody body, Vector3 flat, float distance, float z, float rPeak, float height, float peak, Vector3 wind, bool sheltered, float mass, float now, float dt, int rating, Rotation rotation, Vector3 dimensions )
    {
        // x: last azimuth; y: swept angle; z: ring radius; w: release height

        Vector4 track = default;
        if ( propOrbits != null && propOrbits.ContainsKey( obj ) ) track = propOrbits[obj];

        var velocity = body.Velocity;
        if ( sheltered || distance < 1f || (track.w > 0f && (z < 32f || distance > track.z * 1.8f)) )
        {
            if ( track.w > 0f ) DropOrbit( obj );
            return false;
        }

        float angle = MathF.Atan2( flat.y, flat.x );
        if ( track.w == 0f )
        {
            // Aerodynamic lift must actually pick the prop up before guidance
            // begins, so heavy, sheltered, or weakly exposed props can stay put.
            if ( z < 62f || velocity.z < 85f || distance < rPeak * 0.60f || distance > rPeak * 1.38f || wind.Length < peak * 0.42f ) return false;
            if ( propOrbits == null ) propOrbits = new System.Collections.Generic.Dictionary<GameObject, Vector4>();
            orbitSerial++;
            float ring = Math.Clamp( distance, rPeak * 0.80f, rPeak * 1.12f );
            float release = Math.Clamp( height * (0.215f + 0.018f * (rating - 2)) * (0.91f + 0.18f * Seed( orbitSerial + 31 )), 650f, 1750f );
            track = new Vector4( angle, 0f, ring, release );
        }

        float step = (Wrap( (angle - track.x) / MathF.Tau + 0.5f ) - 0.5f) * MathF.Tau;
        float swept = MathF.Max( 0f, track.y + Math.Clamp( step, -0.50f, 0.50f ) );
        var radial = flat / distance;
        var tangent = new Vector3( -radial.y, radial.x, 0f );
        if ( swept >= 1.50f * MathF.Tau && z >= track.w )
        {
            // A single outward impulse carries the prop clear while retaining
            // its tangential momentum. Gravity takes over the rest of the arc.
            body.ApplyImpulse( (radial * (peak * 0.34f) + Vector3.Up * (peak * 0.04f)) * mass );
            // The prop carries its cooldown, so all overlapping storms honor
            // the same release, even if this tornado is removed mid-flight.
            obj.Tags.Add( OrbitReleaseTag );
            obj.Tags.Add( OrbitReleasePrefix + (int)now );
            DropOrbit( obj );
            return true;
        }

        if ( !obj.Tags.Has( OrbitClaimTag ) )
        {
            obj.Tags.Add( OrbitClaimTag );
            obj.Tags.Add( orbitOwnerTag );
            if ( orbitClaims == null ) orbitClaims = new System.Collections.Generic.List<GameObject>();
            orbitClaims.Add( obj );
        }
        orbitTouched.Add( obj );
        propOrbits[obj] = new Vector4( angle, swept, track.z, track.w );
        float sideSpeed = MathF.Min( peak * 0.59f, track.z * 3.15f );
        float along = Vector3.Dot( velocity, tangent );
        float across = Vector3.Dot( velocity, radial );
        float centripetal = MathF.Min( along * along / MathF.Max( distance, 48f ), 12000f );
        float radialAccel = Math.Clamp( (track.z - distance) * 12f - across * 6f - centripetal, -16000f, 7000f );
        // The ring supplies the inward turn, but it must not make dense props
        // spin up as fast as light props with the same exposed surface area.
        const float metersPerUnit = 0.0254f;
        float sideArea = ProjectedArea( dimensions * metersPerUnit, rotation.Inverse * tangent );
        float windMeters = wind.WithZ( 0f ).Length * metersPerUnit;
        float spinAuthority = Math.Clamp( 1.35f * sideArea * windMeters * windMeters / (mass * metersPerUnit), 220f, 8500f );
        float tangentAccel = Math.Clamp( (sideSpeed - along) * 5f, -spinAuthority, spinAuthority );
        float climb = Math.Clamp( (track.w + 240f - z) * 1.65f, 0f, 405f + 40f * rating );
        float gravity = body.Gravity ? -Scene.PhysicsWorld.Gravity.z * body.GravityScale : 0f;
        float upAccel = Math.Clamp( (climb - velocity.z) * 5f + gravity, -7500f, 7500f );
        body.ApplyImpulse( (radial * radialAccel + tangent * tangentAccel + Vector3.Up * upAccel) * (mass * dt) );
        return true;
    }

    void ApplyAirDrag( Rigidbody body, Rotation rotation, Vector3 dimensions, Vector3 wind, float mass, float dt, float loft )
    {
        const float metersPerUnit = 0.0254f;
        var slip = wind - body.Velocity;
        float speed = slip.Length;
        if ( speed <= 1f ) return;
        var inverse = rotation.Inverse;
        var local = inverse * (slip / speed);
        var size = dimensions * metersPerUnit;
        float area = ProjectedArea( size, local );
        // Quadratic drag with an approximate bluff-body coefficient of 1.05.
        // Integrate the relative-speed decay over this pulse without overshoot.
        float coupling = 0.5f * 1.225f * 1.05f * area * (speed * metersPerUnit) * dt / mass;
        var impulse = slip * (mass * coupling / (1f + coupling));
        if ( loft > 0f )
        {
            // Gameplay lift from wind pressure on exposed area. Keep gravity
            // and mass meaningful, and don't keep accelerating rising props.
            float horizontal = wind.WithZ( 0f ).Length;
            float slipMeters = MathF.Min( horizontal, slip.WithZ( 0f ).Length ) * metersPerUnit;
            float upArea = ProjectedArea( size, inverse * Vector3.Up );
            float liftImpulse = 0.5f * 1.225f * slipMeters * slipMeters * upArea * loft * dt / metersPerUnit;
            float headroom = MathF.Max( 0f, wind.z + 0.62f * horizontal - body.Velocity.z - impulse.z / mass );
            impulse += Vector3.Up * MathF.Min( liftImpulse, 0.45f * mass * headroom );
        }
        body.ApplyImpulse( impulse );
    }

    float ProjectedArea( Vector3 size, Vector3 direction ) =>
        MathF.Abs( direction.x * size.y * size.z ) + MathF.Abs( direction.y * size.x * size.z ) + MathF.Abs( direction.z * size.x * size.y );

    void UpdateTravel()
    {
        float dt = MathF.Min( Time.Delta, 0.1f );
        travelAge += dt;
        float speed = 76f + 20f * MathF.Sin( travelAge * 0.23f + routePhase );
        float turn = 0.065f + 0.045f * MathF.Sin( travelAge * 0.16f + routePhase );
        heading += turn * dt;
        var next = WorldPosition + new Vector3( MathF.Cos( heading ), MathF.Sin( heading ), 0f ) * (speed * dt);
        var ground = TraceGround( next, 128f );
        if ( !ground.Hit || ground.Normal.z < 0.65f )
        {
            // Bend back toward solid ground instead of drifting over the edge.
            heading += 1.8f * dt;
            var support = TraceGround( WorldPosition, 128f );
            if ( support.Hit && support.Normal.z >= 0.65f ) WorldPosition = support.HitPosition;
            else GameObject.Destroy();
            return;
        }
        WorldPosition = ground.HitPosition;
    }

    SceneTraceResult TraceGround( Vector3 position, float depth ) =>
        Scene.Trace.Ray( position + Vector3.Up * 64f, position - Vector3.Up * depth )
            .WithoutTags( "player", "trigger" ).IgnoreDynamic().IgnoreKeyframed().Run();

    protected override void OnDisabled()
    {
        ClearOrbits();
        StopWeather();
        if ( visuals != null && visuals.IsValid ) visuals.Enabled = false;
        if ( debris != null && debris.IsValid ) debris.Enabled = false;
        if ( volume != null && volume.IsValid ) volume.Enabled = false;
    }

    protected override void OnEnabled()
    {
        if ( visuals != null && visuals.IsValid ) visuals.Enabled = true;
        if ( debris != null && debris.IsValid ) debris.Enabled = true;
        if ( volume != null && volume.IsValid ) volume.Enabled = true;
    }

    protected override void OnDestroy()
    {
        ClearOrbits();
        StopWeather();
    }

    /* STORM_WEATHER */


    void CreateDebris()
    {
        debris = MakeVisual( GameObject, "Airborne Debris" );
        var material = Material.Load( "storm_disasters/debris.vmat" );
        var box = Model.Load( "models/dev/box.vmdl" );
        var backing = Material.Load( "materials/dev/primary_white.vmat" );
        var splinter = MakeStrip( backing, new Vector3( -25,-5,0 ), new Vector3( -8,-3,2 ), new Vector3( 8,2,-1 ), new Vector3( 25,8,2 ), new Vector4( 1.2f,3,2,0.35f ) );
        var sheet = MakeStrip( backing, new Vector3( -25,6,0 ), new Vector3( -10,2,2 ), new Vector3( 9,-3,-3 ), new Vector3( 25,2,4 ), new Vector4( 3,9,5,2 ) );
        var shard = MakeStrip( backing, new Vector3( -25,-8,1 ), new Vector3( -9,-4,0 ), new Vector3( 8,-3,-2 ), new Vector3( 24,10,3 ), new Vector4( 2,4,6,1.2f ) );
        for ( int i = 0; i < fragments.Length; i++ )
        {
            var piece = MakeVisual( debris, "Flying fragment" ).Components.Create<ModelRenderer>();
            bool heavy = i % 4 == 0;
            piece.Model = heavy ? (i % 8 == 0 ? box : sheet) : (i % 3 == 0 ? splinter : (i % 3 == 1 ? sheet : shard));
            piece.RenderType = ModelRenderer.ShadowRenderType.Off;
            if ( material != null && material.IsValid && !material.IsError && material.Shader.IsValid && !material.Shader.IsError )
                piece.MaterialOverride = material;
            float shade = 0.038f + (heavy ? 0.105f : 0.068f) * SurfaceSeed( i + 424 );
            piece.Tint = new Color( shade * 1.08f, shade, shade * 0.88f, 1f );
            piece.Attributes.Set( "FragmentColor", new Vector3( shade * 0.30f, shade * 0.25f, shade * 0.19f ) );
            fragments[i] = piece;
        }
    }

    Model MakeStrip( Material backing, Vector3 a, Vector3 b, Vector3 c, Vector3 d, Vector4 widths )
    {
        var vertices = new System.Collections.Generic.List<Vertex>();
        AddSegment( vertices, a, b, widths.x, widths.y );
        AddSegment( vertices, b, c, widths.y, widths.z );
        AddSegment( vertices, c, d, widths.z, widths.w );
        var mesh = new Mesh( backing, MeshPrimitiveType.Triangles );
        mesh.CreateVertexBuffer<Vertex>( vertices.Count, vertices );
        var bounds = new BBox( new Vector3( -26,-22,-8 ), new Vector3( 26,22,8 ) );
        mesh.Bounds = bounds;
        return new ModelBuilder().AddMesh( mesh ).WithViewBounds( bounds ).Create();
    }

    void AddSegment( System.Collections.Generic.List<Vertex> vertices, Vector3 a, Vector3 b, float wa, float wb )
    {
        var l0 = a - Vector3.Left * wa;
        var r0 = a + Vector3.Left * wa * 0.8f;
        var l1 = b - Vector3.Left * wb;
        var r1 = b + Vector3.Left * wb * 0.8f;
        AddFace( vertices, l0, r0, l1 );
        AddFace( vertices, r0, r1, l1 );
    }

    void AddFace( System.Collections.Generic.List<Vertex> vertices, Vector3 a, Vector3 b, Vector3 c )
    {
        var normal = Vector3.Cross( b - a, c - a ).Normal;
        var tangent = (c - a).Normal;
        vertices.Add( new Vertex( a, normal, tangent, new Vector4( 0,0,0,0 ) ) );
        vertices.Add( new Vertex( b, normal, tangent, new Vector4( 0,1,0,0 ) ) );
        vertices.Add( new Vertex( c, normal, tangent, new Vector4( 1,0,0,0 ) ) );
        vertices.Add( new Vertex( a, -normal, tangent, new Vector4( 0,0,0,0 ) ) );
        vertices.Add( new Vertex( c, -normal, tangent, new Vector4( 1,0,0,0 ) ) );
        vertices.Add( new Vertex( b, -normal, tangent, new Vector4( 0,1,0,0 ) ) );
    }

    Texture CreateNoise()
    {
        const string asset = "storm_disasters/funnel_density.txt";
        if ( !FileSystem.Mounted.FileExists( asset ) ) return null;
        // The standalone algorithm is baked before launch; avoid running its voxel loop in Breen.
        var data = Json.Deserialize<byte[]>( FileSystem.Mounted.ReadAllText( asset ) );
        const int n = FunnelNoiseSize;
        if ( data == null || data.Length != n * n * n * 4 ) return null;
        return Texture.CreateVolume( n, n, n, ImageFormat.RGBA8888 ).WithName( "storm_disasters/funnel_density_canonical" ).WithData( data ).Finish();
    }

    float Smooth( float x ) => x * x * (3f - 2f * x);
    float Fade( float x ) => Smooth( MathF.Min( 1f, MathF.Max( 0f, x ) ) );
    float Wrap( float x ) => x - MathF.Floor( x );
    float Seed( int i ) => Wrap( MathF.Sin( i * 115.37f + 5.64f ) * 912.376f );
    float Mix( float a, float b, float t ) => a + (b - a) * t;
    Vector3 FunnelAxis( float t, float h, float groundScale, float rope )
    {
        float bend = MathF.Sin( 4.2f * h - t * 0.65f );
        var axis = new Vector3( h * (bend * 222f - 65f), h * h * 400f + MathF.Sin( 0.42f * t + h * 6.2f ) * 102f * h, 0f );
        if ( Shape == 2 ) return axis * 0.42f;
        float wave = MathF.Sin( h * MathF.Tau ) * MathF.Sin( h * MathF.PI ) * (0.85f + 0.15f * MathF.Sin( t * 0.66f ));
        axis += new Vector3( 180f, -640f, 0f ) * ((rope + (Shape == 0 ? 0.94f : 0f)) * wave);
        if ( Shape == 4 ) axis += new Vector3( 175f, -315f, 0f ) * (MathF.Sin( h * MathF.PI ) * (0.66f + 0.34f * MathF.Cos( t * 0.28f )));
        return axis * groundScale;
    }

    void UpdateFunnel()
    {
        float presetHeight = GameHeight();
        float height = VisibleFunnelHeight( presetHeight );
        float t = MathF.Max( 0f, Time.Now - formedAt );
        float duration = Duration();
        float phaseScale = MathF.Min( 24f, duration );
        float progress = t / phaseScale;
        float remaining = (duration - t) / phaseScale;
        float cloudLife = Fade( progress / 0.10f ) * Fade( remaining / 0.09f );
        float condensation = Fade( progress / 0.095f ) * Fade( remaining / 0.10f );
        float circulation = Fade( progress / 0.055f ) * Fade( remaining / 0.095f );
        float rope = Fade( (0.29f - remaining) / 0.24f );
        // The circulation is already at the surface. The visible cloud tip descends to meet its dust.
        float startFloor = Shape == 2 ? 0.76f : 0.88f;
        // Over twelve seconds at normal lifetime, ease both velocity and acceleration at the ends.
        float descent = Math.Clamp( progress / 0.50f, 0f, 1f );
        float eased = descent * descent * descent * (10f + descent * (-15f + 6f * descent));
        float visibleFloor = GroundContactFloor + (startFloor - GroundContactFloor) * (1f - eased);

        float groundScale = MathF.Sqrt( GameWidthScale() );
        // The walk-in wedge radii are already game-sized at F5.
        float wedgeScale = GameWidthScale() / GameF5WidthScale;
        float width = Shape == 2 ? wedgeScale : GameWidthScale() * (1f - 0.29f * rope);
        var radii = GameRadii() * width;
        float top = GameTopRadius() * width;
        float baseRadius = radii.x;
        float flare = top - baseRadius;
        if ( volume != null && volume.IsValid ) UpdateVolume( t, height, radii, top, groundScale, wedgeScale, rope, cloudLife, condensation, visibleFloor, circulation );
        // Live instances keep the old sprite pool across hot reload. Remove the
        // overlays without touching the actual sprite fallback for the funnel.
        if ( !removedDustOverlays )
        {
            removedDustOverlays = true;
            if ( volume != null && volume.IsValid && visuals != null && visuals.IsValid )
            {
                visuals.Destroy();
                visuals = null;
            }
            else
            {
                for ( int i = FallbackCount; i < puffs.Length; i++ )
                {
                    var dust = puffs[i];
                    if ( dust != null && dust.IsValid ) dust.GameObject.Destroy();
                }
            }
        }
        if ( debris == null || fragments.Length != FragmentCount ) return;
        for ( int i = start; i < FallbackCount; i++ )
        {
            // Keep the fallback dust independent of the descending cloud tip, too.
            bool dust = i < 8;
            float h = dust ? 0f : Wrap( i / (float)FallbackCount + t * 0.12f );
            float a = i * 2.399963f + t * (2.5f - h);
            float radius = SampleRadii( radii, top, h );
            float size = baseRadius * 0.95f + 38f + flare * h * h;
            var puff = puffs[i];
            puff.GameObject.WorldPosition = WorldPosition + FunnelAxis( t, h, groundScale, rope ) + new Vector3( MathF.Cos( a ) * radius, MathF.Sin( a ) * radius, 12f + height * h );
            puff.Size = new Vector2( size, size * 1.28f );
            float edge = Fade( (h - visibleFloor + 0.01f) / 0.125f );
            puff.Color = dust ? new Color( 0.26f, 0.22f, 0.17f, 0.69f * circulation )
                : new Color( 0.24f, 0.25f, 0.27f, 0.69f * condensation * edge );
        }
        UpdateDebris( t, presetHeight, radii, top, groundScale, rope, circulation, progress );
    }

    float DustIntensity() => MathF.Min( 5f, MathF.Max( 0f, Strength ) ) / 5f;

    /* GROUND_EFFECTS */

    float SampleRadii( Vector4 radii, float top, float h )
    {
        float k = h * 4f;
        if ( k < 1f ) return Mix( radii.x, radii.y, k );
        if ( k < 2f ) return Mix( radii.y, radii.z, k - 1f );
        if ( k < 3f ) return Mix( radii.z, radii.w, k - 2f );
        return Mix( radii.w, top, k - 3f );
    }

    float Duration() => Lifetime > 0f ? MathF.Max( 1f, Lifetime ) : 150f;

    void UpdateVolume( float t, float height, Vector4 radii, float top, float groundScale, float wedgeScale, float rope, float cloudLife, float condensation, float visibleFloor, float dustOpacity )
    {
        var b = FunnelAxis( t, 0.25f, groundScale, rope );
        var c = FunnelAxis( t, 0.50f, groundScale, rope );
        var d = FunnelAxis( t, 0.75f, groundScale, rope );
        var e = FunnelAxis( t, 1f, groundScale, rope );
        float axisExtent = MathF.Max( MathF.Max( b.Length, c.Length ), MathF.Max( d.Length, e.Length ) );
        bool wedge = Shape == 2;
        float extent = top * (wedge ? 1.21f : 1.39f) + axisExtent + 95f;
        float cloudScale = 0.78f + 0.22f * groundScale;
        var cloudBounds = wedge ? new Vector3( 3850f, 3150f, 950f ) * MathF.Max( 0.72f, wedgeScale )
            : new Vector3( 2460f, 1700f, 705f ) * cloudScale;
        var cloudCenter = e + (wedge ? new Vector3( 0f, 0f, height + 180f ) : new Vector3( -215f * cloudScale, 135f * cloudScale, height + 180f ));
        float halfX = MathF.Max( extent, MathF.Abs( cloudCenter.x ) + cloudBounds.x );
        float halfY = MathF.Max( extent, MathF.Abs( cloudCenter.y ) + cloudBounds.y );
        float fullHeight = MathF.Max( height * 1.11f, cloudCenter.z + cloudBounds.z );
        var origin = WorldPosition;
        volume.GameObject.WorldRotation = Rotation.Identity;
        volume.GameObject.WorldPosition = origin + new Vector3( 0f, 0f, fullHeight * 0.5f );
        volume.GameObject.LocalScale = new Vector3( halfX * 2f, halfY * 2f, fullHeight ) / 50f;
        volume.Attributes.Set( "VortexOrigin", origin );
        volume.Attributes.Set( "VortexForward", new Vector2( 1f, 0f ) );
        volume.Attributes.Set( "VortexBounds", new Vector4( extent, fullHeight, height, wedge ? GameOpenCore() * wedgeScale : 0f ) );
        volume.Attributes.Set( "VortexWedge", wedge ? 1f : 0f );
        volume.Attributes.Set( "VortexRadii", radii );
        volume.Attributes.Set( "VortexPhase", new Vector4( top, visibleFloor, condensation, t ) );
        volume.Attributes.Set( "VortexDustOpacity", dustOpacity );
        // Stronger tornadoes loft more material and break it into denser, sharper rolls.
        float intensity = DustIntensity();
        volume.Attributes.Set( "VortexDustProfile", new Vector4( 275f + 500f * intensity, (230f + 285f * intensity) * (wedge ? 0.62f : 1f), 2.55f + 2.25f * intensity, intensity ) );
        volume.Attributes.Set( "VortexAxisX", new Vector4( 0f, b.x, c.x, d.x ) );
        volume.Attributes.Set( "VortexAxisY", new Vector4( 0f, b.y, c.y, d.y ) );
        volume.Attributes.Set( "VortexTop", new Vector2( e.x, e.y ) );
        volume.Attributes.Set( "StormCloudCenter", cloudCenter );
        volume.Attributes.Set( "StormCloudBounds", new Vector4( cloudBounds.x, cloudBounds.y, cloudBounds.z, cloudLife ) );
    }
}
