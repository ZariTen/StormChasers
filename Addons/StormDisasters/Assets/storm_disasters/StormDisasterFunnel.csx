        0.595541954f, 0.467003882f, 0.650699317f, 0.973739147f, 0.200972676f, 0.922609866f, 0.846164107f, 0.570529580f,
        0.642157674f, 0.215664089f, 0.485141933f, 0.362862527f, 0.439304769f, 0.228737891f, 0.584871113f, 0.295791686f,
        0.220538855f, 0.963999987f, 0.839772582f, 0.282030880f, 0.709393501f, 0.683140218f, 0.973191261f, 0.267703056f,
        0.437030613f, 0.910787165f, 0.885066032f, 0.746241093f, 0.762585163f, 0.475314498f, 0.837770283f, 0.402835906f,
        0.289461732f, 0.478094339f, 0.443089783f, 0.861020386f, 0.531033397f, 0.618664920f, 0.957736969f, 0.964451194f,
        0.849079549f, 0.718578994f, 0.339656830f, 0.693137705f, 0.0853954554f, 0.696011603f, 0.453232944f, 0.181645215f,
        0.709671557f, 0.0654073954f, 0.532497406f, 0.0334244967f, 0.802122116f, 0.189569533f, 0.974865437f, 0.154105783f,
        0.623688042f, 0.980861843f, 0.00332510471f, 0.579787731f, 0.990104556f, 0.138609171f, 0.136129439f, 0.212959826f,
        0.897477925f, 0.229101896f, 0.832526743f, 0.765848756f, 0.701242626f, 0.704977095f, 0.941849470f, 0.374065757f,
        0.682935178f, 0.783894300f, 0.663023412f, 0.256443083f, 0.495593548f, 0.692345262f, 0.317494273f, 0.393285692f,
        0.00344604254f, 0.293466151f, 0.467504919f, 0.614741266f, 0.174098492f, 0.173564255f, 0.368669927f, 0.515628874f,
        0.489398479f, 0.607387245f, 0.616401613f, 0.917725444f, 0.105371475f, 0.123380661f, 0.573818743f, 0.0940617919f,
        0.562729061f, 0.998787880f, 0.491632998f, 0.878655791f, 0.222837508f, 0.480785668f, 0.908497632f, 0.787329197f,
        0.556155145f, 0.836524665f, 0.311688006f, 0.828400373f, 0.838335514f, 0.292626739f, 0.222056329f, 0.820261121f,
        0.337281764f, 0.0573847890f, 0.344482422f, 0.0263020992f, 0.642051220f, 0.602813244f, 0.0997786522f, 0.832772732f,
        0.00213319063f, 0.799938500f, 0.0188768506f, 0.00642567873f, 0.410848320f, 0.515794039f,
    };
    float SurfaceSeed( int i ) => surfaceSeeds[i];
    Vector3 Orbit( float angle, float radius, float aspect ) => new Vector3( MathF.Cos( angle ) * radius, MathF.Sin( angle ) * radius * aspect, 0f );
    void UpdateDust( float t, float height, float groundScale, float wedge, float wedgeScale, Vector4 radii, float top, float rope, float circulation )
    {
        for ( var i = 0; i < DustCount; i++ )
        {
            var renderer = puffs[FallbackCount + i];
            var v = SurfaceSeed( i + 202 );
            var cycle = Wrap( i / (float)DustCount + t * (.14f + .09f * v) );
            var angle = i * GoldenAngle + t * (1.53f + .41f * v) + cycle * 1.45f;
            var skirt = i % 3 != 0;
            if ( !skirt )
            {
                UpdateDustShroud( renderer, i, v, t, height, groundScale, radii, top, rope, circulation );
                continue;
            }
            var radius = (skirt ? 140 + 675 * cycle * (.75f + .48f * v) : 52 + 195 * cycle) * groundScale;
            radius += 880 * wedgeScale * wedge;
            var size = (skirt ? 230 + 405 * cycle + 95 * v : 204 + 190 * cycle + 90 * v) * groundScale;
            var band = .67f + .33f * MathF.Cos( angle * 2 - t * 2.7f );
            var opacity = Fade( cycle / .10f ) * Fade( (1 - cycle) / .39f ) * (.63f + .37f * band);
            renderer.WorldPosition = WorldPosition + Orbit( angle, radius, .77f ) + Vector3.Up * (skirt ? 13 + 58 * v * (1 - cycle) : 46 + 105 * v * (1 - cycle));
            renderer.Size = new Vector2( size, size * (skirt ? .24f + .16f * v : .53f + .16f * v) );
            // A dark, loamy inner swirl and a cooler rain-mixed skirt, not an orange dust cloud in a downpour.
            var shade = (skirt ? .24f : .125f) + .14f * v;
            renderer.FogStrength = .48f;
            renderer.Color = new Color( shade * 1.03f, shade, shade * (skirt ? .98f : .90f), (skirt ? .69f : .91f) * opacity * circulation );
        }
    }
    void UpdateDebris( float t, float height, Vector4 radii, float top, float groundScale, float rope, float circulation, float progress )
    {
        var loft = .20f + .80f * Fade( progress / .30f );
        for ( var i = 0; i < FragmentCount; i++ )
        {
            var piece = fragments[i].GameObject;
            var v = SurfaceSeed( i + 410 );
            var drift = SurfaceSeed( i + 517 );
            var heavy = i % 4 == 0;
            var thrown = !heavy && i % 9 == 1;
            var phase = Wrap( (i + .5f) / FragmentCount + t * (heavy ? .145f + .10f * v : .096f + .078f * v) );
            // Boards arc and fall; lighter sheets and splinters are carried up the flank.
            var rise = heavy ? MathF.Sin( phase * MathF.PI ) * (.055f + .19f * v)
                : MathF.Pow( phase, 1.24f ) * (.76f + .29f * v );
            var escape = thrown ? Fade( (phase - .48f) / .48f ) : 0;
            var h = MathF.Min( .97f, MathF.Max( 0f, .008f + (rise - .17f * escape) * loft ) );
            var angle = i * GoldenAngle + t * (.79f + .57f * v) + phase * (heavy ? 5.3f : 7.9f);
            var edge = SampleRadii( radii, top, h );
            var skirt = (heavy ? 145 + 420 * drift : 195 + 540 * drift + 630 * h) * groundScale;
            var radius = edge * (.83f + .32f * v) + skirt * (.45f + .55f * Fade( phase * 3 ));
            var kick = groundScale * escape * (320 + 470 * drift);
            var axis = FunnelAxis( t, h, groundScale, rope );
            var position = axis + Orbit( angle, radius, .88f ) + new Vector3( .65f * kick, -.76f * kick, h * height );
            piece.WorldPosition = WorldPosition + position;
            piece.LocalRotation = Rotation.From( new Angles( t * (100 + 195 * v) + i * 23, t * (75 + 138 * drift) + i * 31, t * (100 + 175 * drift) + i * 17 ) );
            var life = circulation * Fade( phase / .085f ) * Fade( (1 - phase) / .13f );
            var length = (heavy ? 15 + 36 * v : 8 + 20 * v) * life / 50f;
            var breadth = (.64f + .56f * drift) * (heavy ? 1 : 1 + .26f * h);
            var board = heavy && i % 8 == 0;
            piece.LocalScale = new Vector3( length, length * breadth * (board ? .38f : 1), length * (heavy ? .09f : .61f) );
        }
    }

    float SampleRadii( Vector4 radii, float top, float h )
    {
        float k = h * 4f;
        if ( k < 1f ) return Mix( radii.x, radii.y, k );
        if ( k < 2f ) return Mix( radii.y, radii.z, k - 1f );
        if ( k < 3f ) return Mix( radii.z, radii.w, k - 2f );
        return Mix( radii.w, top, k - 3f );
    }

    float Duration() => Lifetime > 0f ? MathF.Max( 1f, Lifetime ) : 150f;

    void UpdateVolume( float t, float height, Vector4 radii, float top, float groundScale, float wedgeScale, float rope, float cloudLife, float condensation )
    {
        var b = FunnelAxis( t, 0.25f, groundScale, rope );
        var c = FunnelAxis( t, 0.50f, groundScale, rope );
        var d = FunnelAxis( t, 0.75f, groundScale, rope );
        var e = FunnelAxis( t, 1f, groundScale, rope );
        float axisExtent = MathF.Max( MathF.Max( b.Length, c.Length ), MathF.Max( d.Length, e.Length ) );
        bool wedge = Shape == 2;
        float extent = top * (wedge ? 1.21f : 1.39f) + axisExtent + 95f;
        float cloudScale = 0.78f + 0.22f * groundScale;
        var cloudBounds = wedge ? new Vector3( 3850f, 3150f, 950f ) * MathF.Max( 0.72f, wedgeScale )
            : new Vector3( 2460f, 1700f, 705f ) * cloudScale;
        var cloudCenter = e + (wedge ? new Vector3( 0f, 0f, height + 180f ) : new Vector3( -215f * cloudScale, 135f * cloudScale, height + 180f ));
        float halfX = MathF.Max( extent, MathF.Abs( cloudCenter.x ) + cloudBounds.x );
        float halfY = MathF.Max( extent, MathF.Abs( cloudCenter.y ) + cloudBounds.y );
        float fullHeight = MathF.Max( height * 1.11f, cloudCenter.z + cloudBounds.z );
        var origin = WorldPosition;
        volume.GameObject.WorldRotation = Rotation.Identity;
        volume.GameObject.WorldPosition = origin + new Vector3( 0f, 0f, fullHeight * 0.5f );
        volume.GameObject.LocalScale = new Vector3( halfX * 2f, halfY * 2f, fullHeight ) / 50f;
        volume.Attributes.Set( "VortexOrigin", origin );
        volume.Attributes.Set( "VortexForward", new Vector2( 1f, 0f ) );
        volume.Attributes.Set( "VortexBounds", new Vector4( extent, fullHeight, height, wedge ? GameOpenCore() * wedgeScale : 0f ) );
        volume.Attributes.Set( "VortexWedge", wedge ? 1f : 0f );
        volume.Attributes.Set( "VortexRadii", radii );
        volume.Attributes.Set( "VortexPhase", new Vector4( top, GroundContactFloor, condensation, t ) );
        // Stronger tornadoes loft more material and break it into denser, sharper rolls.
        float intensity = DustIntensity();
        volume.Attributes.Set( "VortexDustProfile", new Vector4( 275f + 500f * intensity, (230f + 285f * intensity) * (wedge ? 0.62f : 1f), 2.55f + 2.25f * intensity, intensity ) );
        volume.Attributes.Set( "VortexAxisX", new Vector4( 0f, b.x, c.x, d.x ) );
        volume.Attributes.Set( "VortexAxisY", new Vector4( 0f, b.y, c.y, d.y ) );
        volume.Attributes.Set( "VortexTop", new Vector2( e.x, e.y ) );
        volume.Attributes.Set( "StormCloudCenter", cloudCenter );
        volume.Attributes.Set( "StormCloudBounds", new Vector4( cloudBounds.x, cloudBounds.y, cloudBounds.z, cloudLife ) );
    }
}
