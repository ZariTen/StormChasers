    void UpdateDebris( float t, float height, Vector4 radii, float top, float bend )
    {
        for ( int i = 0; i < fragments.Length; i++ )
        {
            var piece = fragments[i].GameObject;
            float v = Seed( i + 410 );
            float drift = Seed( i + 517 );
            bool heavy = i % 4 == 0;
            float phase = Wrap( (i + 0.5f) / fragments.Length + t * (heavy ? 0.18f + 0.10f * v : 0.10f + 0.08f * v) );
            float h = heavy ? MathF.Sin( phase * MathF.PI ) * (0.04f + 0.17f * v) : MathF.Pow( phase, 1.24f ) * (0.56f + 0.36f * v);
            float angle = i * 2.399963f + t * (0.79f + 0.57f * v) + phase * (heavy ? 5.3f : 7.9f);
            float radius = SampleRadii( radii, top, h ) + 22f + 47f * drift;
            piece.WorldPosition = WorldPosition + new Vector3( AxisX( t, h, bend ) + MathF.Cos( angle ) * radius, AxisY( t, h, bend ) + MathF.Sin( angle ) * radius, 8f + h * height );
            piece.LocalRotation = Rotation.From( new Angles( t * (100f + 195f * v) + i * 23f, t * (75f + 138f * drift), t * (100f + 175f * drift) ) );
            float life = Fade( phase / 0.085f ) * Fade( (1f - phase) / 0.13f );
            float length = (heavy ? 9f + 17f * v : 6f + 12f * v) * life / 50f;
            piece.LocalScale = new Vector3( length, length * (i % 8 == 0 ? 0.38f : 0.72f + 0.48f * drift), length * (i % 8 == 0 ? 0.09f : 0.61f) );
        }
    }

    float SampleRadii( Vector4 radii, float top, float h )
    {
        float k = h * 4f;
        if ( k < 1f ) return Mix( radii.x, radii.y, k );
        if ( k < 2f ) return Mix( radii.y, radii.z, k - 1f );
        if ( k < 3f ) return Mix( radii.z, radii.w, k - 2f );
        return Mix( radii.w, top, k - 3f );
    }

    void UpdateVolume( float t, float height, Vector4 radii, float top, float bend )
    {
        float widest = MathF.Max( top, MathF.Max( MathF.Max( radii.x, radii.y ), MathF.Max( radii.z, radii.w ) ) );
        float extent = widest * 1.4f + bend + 32f;
        float cloudRadius = Strength >= 5 ? 640f : (Strength == 1 ? 170f : 340f);
        float cloudHeight = Strength >= 5 ? 145f : 90f;
        float fullHeight = height + cloudHeight + 55f;
        float bounds = MathF.Max( extent, cloudRadius + bend + 10f );
        float topX = AxisX( t, 1f, bend );
        float topY = AxisY( t, 1f, bend );
        var origin = WorldPosition;
        volume.GameObject.WorldRotation = Rotation.Identity;
        volume.GameObject.WorldPosition = origin + new Vector3( 0f, 0f, fullHeight * 0.5f );
        volume.GameObject.LocalScale = new Vector3( bounds * 2f, bounds * 2f, fullHeight ) / 50f;
        volume.Attributes.Set( "VortexOrigin", origin );
        volume.Attributes.Set( "VortexForward", new Vector2( 1f, 0f ) );
        volume.Attributes.Set( "VortexBounds", new Vector4( extent, fullHeight, height, Strength >= 5 ? GameOpenCore() * DisplayScale : 0f ) );
        volume.Attributes.Set( "VortexWedge", Strength >= 5 ? 1f : 0f );
        volume.Attributes.Set( "VortexRadii", radii );
        volume.Attributes.Set( "VortexPhase", new Vector4( top, 0f, Strength == 1 ? 2.2f : 1.85f, t ) );
        volume.Attributes.Set( "VortexAxisX", new Vector4( 0f, AxisX( t, 0.25f, bend ), AxisX( t, 0.5f, bend ), AxisX( t, 0.75f, bend ) ) );
        volume.Attributes.Set( "VortexAxisY", new Vector4( 0f, AxisY( t, 0.25f, bend ), AxisY( t, 0.5f, bend ), AxisY( t, 0.75f, bend ) ) );
        volume.Attributes.Set( "VortexTop", new Vector2( topX, topY ) );
        volume.Attributes.Set( "StormCloudCenter", new Vector3( topX, topY, height + 30f ) );
        volume.Attributes.Set( "StormCloudBounds", new Vector4( cloudRadius, cloudRadius * 0.76f, cloudHeight, 1.5f ) );
    }
