    float AxisY( float t, float h, float bend ) => MathF.Cos( t * 0.57f + h * 4f ) * h * bend;

    void UpdateFunnel()
    {
        float height = GameHeight() * DisplayScale;
        float width = (Strength >= 5 ? 1f : GameWidthScale()) * DisplayScale;
        var radii = GameRadii() * width;
        float top = GameTopRadius() * width;
        float baseRadius = radii.x;
